<?xml version="1.0"?>
<ruleset name="GoCardlessPro">
    <description>PHP CodeSniffer configuration for GoCardlessPro</description>

    <!-- Use PSR12 as the base standard -->
    <rule ref="PSR12">
        <!-- Allow _do* method names in Services (used with __call magic method) -->
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
    </rule>

    <!-- Check all PHP files -->
    <file>lib</file>
    <file>tests</file>

    <!-- Show colors in output -->
    <arg name="colors"/>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Only fail on errors, not warnings -->
    <config name="ignore_warnings_on_exit" value="1"/>
</ruleset>
